        function handleAddSchedule(e) {
            e.preventDefault();
            const dateId = appState.selectedDate === 'ALL' ? TRIP_DATES[0].id : appState.selectedDate;
            const cat = appState.formCategory;
            const time = document.getElementById('schedTime').value || '12:00';
            let newItem = {
                id: 'sched_' + Date.now(),
                category: cat,
                time: time,
                cost: 0
            };

            if (cat === 'sightseeing') {
                const spot = document.getElementById('sightSpot').value.trim();
                if (!spot) { showToast('スポット名を入力してください', 'error'); return; }
                newItem.spot = spot;
                newItem.action = document.getElementById('sightAction').value.trim();
                newItem.memo = document.getElementById('sightMemo').value.trim();
                newItem.mapUrl = document.getElementById('sightMapUrl').value.trim();
                newItem.cost = parseFloat(document.getElementById('schedCost').value) || 0;
            } else if (cat === 'dining') {
                const name = document.getElementById('dineName').value.trim();
                if (!name) { showToast('店名を入力してください', 'error'); return; }
                newItem.dineType = document.getElementById('dineType').value;
                newItem.name = name;
                newItem.memo = document.getElementById('dineMemo').value.trim();
                newItem.url = document.getElementById('dineUrl').value.trim();
                newItem.cost = parseFloat(document.getElementById('schedCost').value) || 0;
            } else if (cat === 'transport') {
                const from = document.getElementById('transFrom').value.trim();
                const to = document.getElementById('transTo').value.trim();
                if (!from || !to) { showToast('出発地と目的地を入力してください', 'error'); return; }
                newItem.mode = document.getElementById('transMode').value;
                newItem.line = document.getElementById('transLine').value;
                newItem.busNo = document.getElementById('transBusNo').value.trim();
                newItem.from = from;
                newItem.to = to;
                newItem.duration = document.getElementById('transDuration').value.trim();
                newItem.cost = parseFloat(document.getElementById('transFare').value) || 0;
            } else if (cat === 'other') {
                const title = document.getElementById('otherTitle').value.trim();
                if (!title) { showToast('件名・タイトルを入力してください', 'error'); return; }
                newItem.title = title;
                newItem.memo = document.getElementById('otherMemo').value.trim();
                newItem.cost = parseFloat(document.getElementById('schedCost').value) || 0;
            }

            if (!appState.schedules[dateId]) {
                appState.schedules[dateId] = [];
            }
            appState.schedules[dateId].push(newItem);
            saveState();

            // Reset text fields
            document.getElementById('addScheduleForm').reset();
            document.getElementById('schedTime').value = time;
            setFormCategory(cat);
            updateSchedCostPreview();

            renderAll();
            showToast(appState.selectedDate === 'ALL' ? 'Day 1 (12/01) の旅程に予定を追加しました' : '旅程に新しい予定を追加しました');
        }

        function deleteScheduleItem(id, targetDateId = null) {
            const dateId = targetDateId || appState.selectedDate;
            if (!appState.schedules[dateId]) return;
            appState.schedules[dateId] = appState.schedules[dateId].filter(item => item.id !== id);
            saveState();
            renderAll();
            showToast('予定を削除しました');
        }

        function recordScheduleToExpense(id, targetDateId = null) {
            const dateId = targetDateId || appState.selectedDate;
            const item = (appState.schedules[dateId] || []).find(s => s.id === id);
            if (!item || !item.cost || item.cost <= 0) return;

            let title = '';
            let expCat = 'その他';
            if (item.category === 'sightseeing') {
                title = item.spot;
                expCat = 'その他';
            } else if (item.category === 'dining') {
                title = `${item.name} (${item.dineType.split(' ')[0]})`;
                expCat = '食事';
            } else if (item.category === 'transport') {
                title = `${item.mode}: ${item.from} → ${item.to}`;
                expCat = '交通費';
            } else {
                title = item.title;
                expCat = 'その他';
            }

            if (!appState.expenses[dateId]) appState.expenses[dateId] = [];
            appState.expenses[dateId].push({
                id: 'exp_' + Date.now(),
                title: title,
                category: expCat,
                amount: Number(item.cost)
            });
            saveState();
            renderAll();
            showToast(`「${title}」(${formatGbp(item.cost)}) を家計簿に計上しました`);
        }

        function getTubeLineBadgeColor(line) {
            const map = {
                'Piccadilly': 'bg-[#003688] text-white',
                'Bakerloo': 'bg-[#B36305] text-white',
                'Central': 'bg-[#E32017] text-white',
                'District': 'bg-[#00782A] text-white',
                'Jubilee': 'bg-[#A0A5A9] text-slate-900',
                'Northern': 'bg-[#000000] text-white',
                'Victoria': 'bg-[#0098D4] text-white',
                'Elizabeth': 'bg-[#6950A1] text-white',
                'Circle': 'bg-[#FFD300] text-slate-900',
                'Metropolitan': 'bg-[#9B0056] text-white'
            };
            return map[line] || 'bg-ukblue text-white';
        }

        function renderItinerary() {
            const isAll = appState.selectedDate === 'ALL';
            const timeline = document.getElementById('scheduleTimeline');

            if (isAll) {
                let allItems = [];
                TRIP_DATES.forEach((d, idx) => {
                    const dayList = [...(appState.schedules[d.id] || [])].sort((a, b) => a.time.localeCompare(b.time));
                    dayList.forEach(item => {
                        allItems.push({ ...item, _dateId: d.id, _dayLabel: `Day ${idx + 1} (${d.short})` });
                    });
                });

                document.getElementById('scheduleCountBadge').textContent = `${allItems.length} 件`;
                const estTotal = allItems.reduce((sum, item) => sum + (Number(item.cost) || 0), 0);
                document.getElementById('dailyEstimatedSum').textContent = `8日間予定予算計: ${formatGbp(estTotal)} (${formatJpy(estTotal)})`;

                if (allItems.length === 0) {
                    timeline.innerHTML = `
                        <div class="pl-10 py-12 text-center">
                            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-lg">
                                <i class="fa-regular fa-calendar-plus"></i>
                            </div>
                            <p class="text-sm font-semibold text-slate-500">予定はまだ登録されていません</p>
                        </div>
                    `;
                    return;
                }

                timeline.innerHTML = allItems.map(item => buildTimelineItemHtml(item, item._dateId, item._dayLabel)).join('');
                return;
            }

            const dateId = appState.selectedDate;
            const items = [...(appState.schedules[dateId] || [])].sort((a, b) => a.time.localeCompare(b.time));
            document.getElementById('scheduleCountBadge').textContent = `${items.length} 件`;

            const estTotal = items.reduce((sum, item) => sum + (Number(item.cost) || 0), 0);
            document.getElementById('dailyEstimatedSum').textContent = `予定予算計: ${formatGbp(estTotal)} (${formatJpy(estTotal)})`;

            if (items.length === 0) {
                timeline.innerHTML = `
                    <div class="pl-10 py-12 text-center">
                        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-lg">
                            <i class="fa-regular fa-calendar-plus"></i>
                        </div>
                        <p class="text-sm font-semibold text-slate-500">この日の予定はまだ登録されていません</p>
                        <p class="text-xs text-slate-400 mt-1">下のフォームから観光スポットや食事・移動を追加しましょう</p>
                    </div>
                `;
                return;
            }

            timeline.innerHTML = items.map(item => buildTimelineItemHtml(item, dateId, null)).join('');
        }

