            const mode = document.getElementById('transMode').value;
            const lineCont = document.getElementById('undergroundLineContainer');
            const busCont = document.getElementById('busDetailContainer');

            if (mode === 'Underground') {
                lineCont.classList.remove('hidden');
                busCont.classList.add('hidden');
            } else if (mode === 'Bus') {
                lineCont.classList.add('hidden');
                busCont.classList.remove('hidden');
            } else {
                lineCont.classList.add('hidden');
                busCont.classList.add('hidden');
            }
