            const container = document.getElementById('dateButtonsContainer');
            const isAllSelected = appState.selectedDate === 'ALL';
            const currentObj = TRIP_DATES.find(d => d.id === appState.selectedDate) || TRIP_DATES[0];
            
            document.getElementById('currentSelectedDateLabel').textContent = isAllSelected
                ? '全体 (12/01 - 12/08)'
                : `${currentObj.short} (${currentObj.day})`;

            const totalSchedCount = TRIP_DATES.reduce((sum, d) => sum + (appState.schedules[d.id] || []).length, 0);

            const allBtnHtml = `
                <button onclick="selectDate('ALL')" 
                        class="flex flex-col items-center justify-center py-2 px-3 rounded-xl border text-center transition shrink-0 snap-align-start relative min-w-[60px] ${
