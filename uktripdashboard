                            ? 'bg-uknavy text-white border-uknavy shadow-md ring-2 ring-ukgold/60' 
                            : 'bg-amber-50/80 hover:bg-amber-100 text-uknavy border-amber-200'
                        }">
                    <span class="text-[9px] font-bold uppercase ${isAllSelected ? 'text-ukgold' : 'text-amber-700'}">ALL</span>
