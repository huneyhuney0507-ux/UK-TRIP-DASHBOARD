        let appState = loadState();

        function loadState() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    return { ...DEFAULT_STATE, ...parsed };
                }
            } catch (e) {
                console.error('Failed to load state:', e);
            }
            return JSON.parse(JSON.stringify(DEFAULT_STATE));
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            } catch (e) {
                console.error('Failed to save state:', e);
            }
        }

        // ==========================================
        // UTILITY & FORMATTING
        // ==========================================
        function formatGbp(val) {
            return '£' + Number(val || 0).toFixed(2);
        }

        function formatJpy(gbpVal) {
            const jpy = Math.round(Number(gbpVal || 0) * appState.exchangeRate);
            return '¥' + jpy.toLocaleString('ja-JP');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const bgClass = type === 'error' ? 'bg-red-700' : 'bg-uknavy';
            const iconClass = type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check text-ukgold';
            toast.className = `${bgClass} text-white px-4 py-3 rounded-xl shadow-lg text-xs font-semibold flex items-center gap-2.5 animate-fade-in pointer-events-auto border border-white/10`;
            toast.innerHTML = `<i class="fa-solid ${iconClass} text-sm"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 2600);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ==========================================
        // NAVIGATION & HEADER CONTROLS
        // ==========================================
        function updateExchangeRate() {
            const input = document.getElementById('exchangeRateInput');
            const rate = parseFloat(input.value);
            if (isNaN(rate) || rate <= 0) {
                showToast('有効な為替レートを入力してください', 'error');
                return;
            }
            appState.exchangeRate = rate;
            saveState();
            updateSchedCostPreview();
            updateExpenseJpyPreview();
            renderAll();
            showToast(`為替レートを 1 GBP = ¥${rate.toFixed(2)} に更新しました`);
        }

        function switchMainTab(tabName) {
            appState.activeTab = tabName;
            saveState();

            const tabs = ['itinerary', 'budget', 'checklist'];
            tabs.forEach(t => {
                const btn = document.getElementById(`tab${t.charAt(0).toUpperCase() + t.slice(1)}Btn`);
                const sec = document.getElementById(`section${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (t === tabName) {
                    btn.className = 'flex flex-col items-center justify-center gap-1 text-white font-bold';
                    sec.classList.remove('hidden');
                } else {
                    btn.className = 'flex flex-col items-center justify-center gap-1 text-white/70 font-medium';
                    sec.classList.add('hidden');
                }
            });

            // Hide date selector on checklist tab
            const dateBar = document.getElementById('dateSelectorBar');
            if (tabName === 'checklist') {
                dateBar.classList.add('hidden');
            } else {
                dateBar.classList.remove('hidden');
            }

            renderAll();
        }

        function selectDate(dateId) {
            appState.selectedDate = dateId;
            saveState();
            renderAll();
        }

