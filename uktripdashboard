        // ==========================================
        // SECTION 2: BUDGET & EXPENSE
        // ==========================================
        function promptEditDailyTotalBudget() {
            const isAll = appState.selectedDate === 'ALL';
            const dateId = isAll ? TRIP_DATES[0].id : appState.selectedDate;
            const dateObj = TRIP_DATES.find(d => d.id === dateId) || TRIP_DATES[0];
            const currentBudget = appState.dailyBudgets[dateId] ?? 100;

            document.getElementById('budgetModalDateLabel').textContent = isAll
                ? `全日程一括：1日あたりの予算上限 (£ GBP) ※8日間合計に反映されます`
                : `${dateObj.jp} の予算上限 (£ GBP)`;
            const input = document.getElementById('modalBudgetInput');
            input.value = currentBudget;
            document.getElementById('modalBudgetJpyPreview').textContent = isAll
                ? `≈ ${formatJpy(currentBudget)} /日（8日間計: ${formatGbp(currentBudget * 8)} / ${formatJpy(currentBudget * 8)}）`
                : `≈ ${formatJpy(currentBudget)} JPY`;

            input.oninput = () => {
                const v = parseFloat(input.value) || 0;
                document.getElementById('modalBudgetJpyPreview').textContent = isAll
                    ? `≈ ${formatJpy(v)} /日（8日間計: ${formatGbp(v * 8)} / ${formatJpy(v * 8)}）`
                    : `≈ ${formatJpy(v)} JPY`;
            };

            const modal = document.getElementById('budgetModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeBudgetModal() {
            const modal = document.getElementById('budgetModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveDailyTotalBudget() {
            const val = parseFloat(document.getElementById('modalBudgetInput').value);
            if (isNaN(val) || val < 0) {
                showToast('0以上の有効な金額を入力してください', 'error');
                return;
            }
            if (appState.selectedDate === 'ALL') {
                TRIP_DATES.forEach(d => {
                    appState.dailyBudgets[d.id] = val;
                });
                saveState();
                closeBudgetModal();
                renderBudget();
                showToast(`全8日間の1日あたり予算を ${formatGbp(val)}（合計 ${formatGbp(val * 8)}）に更新しました`);
            } else {
                appState.dailyBudgets[appState.selectedDate] = val;
                saveState();
                closeBudgetModal();
                renderBudget();
                showToast('1日の目標予算を更新しました');
            }
        }

        function updateExpenseJpyPreview() {
            const val = parseFloat(document.getElementById('expAmount').value) || 0;
            document.getElementById('expCalcJpy').textContent = `${formatJpy(val)} JPY`;
        }

        function handleAddExpense(e) {
            e.preventDefault();
            const title = document.getElementById('expTitle').value.trim();
            const amount = parseFloat(document.getElementById('expAmount').value);
            const category = document.getElementById('expCategory').value;

            if (!title || isNaN(amount) || amount <= 0) {
                showToast('品名と正しい金額を入力してください', 'error');
                return;
            }

            const dateId = appState.selectedDate === 'ALL'
                ? (document.getElementById('expTargetDate').value || TRIP_DATES[0].id)
                : appState.selectedDate;

            if (!appState.expenses[dateId]) {
                appState.expenses[dateId] = [];
            }
            appState.expenses[dateId].push({
                id: 'exp_' + Date.now(),
                title,
                category,
                amount
            });
            saveState();

            document.getElementById('addExpenseForm').reset();
            updateExpenseJpyPreview();
            renderBudget();
            showToast('支出を記録しました');
        }

        function deleteExpenseItem(id, targetDateId = null) {
            const dateId = targetDateId || appState.selectedDate;
            if (!appState.expenses[dateId]) return;
            appState.expenses[dateId] = appState.expenses[dateId].filter(e => e.id !== id);
            saveState();
            renderBudget();
            showToast('支出記録を削除しました');
        }

        function renderBudget() {
            const isAll = appState.selectedDate === 'ALL';
            const dateId = appState.selectedDate;
            const dateObj = TRIP_DATES.find(d => d.id === dateId) || TRIP_DATES[0];

            // Populate & toggle date selector inside expense form when in ALL view
            const expDateContainer = document.getElementById('expenseDateSelectContainer');
            const expTargetDateSelect = document.getElementById('expTargetDate');
            if (isAll) {
                expDateContainer.classList.remove('hidden');
                expTargetDateSelect.innerHTML = TRIP_DATES.map((d, idx) =>
                    `<option value="${d.id}">Day ${idx + 1} - ${d.jp}</option>`
                ).join('');
            } else {
                expDateContainer.classList.add('hidden');
            }

            // Compute budget & expenses
            let periodTotalBudget = 0;
            let periodExpenses = [];

            if (isAll) {
                TRIP_DATES.forEach((d, idx) => {
                    periodTotalBudget += Number(appState.dailyBudgets[d.id] ?? 100);
                    const dayExps = appState.expenses[d.id] || [];
                    dayExps.forEach(exp => {
                        periodExpenses.push({
                            ...exp,
                            _dateId: d.id,
                            _dayShort: `Day ${idx + 1}`
                        });
                    });
                });
            } else {
                periodTotalBudget = Number(appState.dailyBudgets[dateId] ?? 100);
                periodExpenses = (appState.expenses[dateId] || []).map(exp => ({
                    ...exp,
                    _dateId: dateId,
                    _dayShort: `${dateObj.short}`
                }));
            }

            const spentPeriod = periodExpenses.reduce((sum, item) => sum + Number(item.amount || 0), 0);
            const remaining = periodTotalBudget - spentPeriod;
            const remPercent = periodTotalBudget > 0
                ? Math.max(0, Math.min(100, Math.round((remaining / periodTotalBudget) * 100)))
                : 0;

            document.getElementById('budgetDateHeading').textContent = isAll
                ? '全体 (1〜8日目合計) 残り'
                : `${dateObj.short} (${dateObj.day}) の残り`;
            
            const remGbpEl = document.getElementById('mainRemGbp');
            remGbpEl.textContent = formatGbp(remaining);
            remGbpEl.className = `text-4xl sm:text-5xl font-black tracking-tight ${remaining < 0 ? 'text-ukred' : 'text-slate-800'}`;
            
            document.getElementById('mainRemJpy').textContent = `(=${formatJpy(remaining)})`;
            document.getElementById('mainTotalGbp').textContent = formatGbp(periodTotalBudget);
            document.getElementById('mainTotalJpy').textContent = `(=${formatJpy(periodTotalBudget)})`;

            // Update Donut/Progress Bar
            const bar = document.getElementById('mainDonutBar');
            bar.style.width = `${remPercent}%`;
            if (remaining < 0) {
                bar.className = 'bg-red-700 h-full transition-all duration-500 rounded-full';
            } else if (remPercent < 25) {
                bar.className = 'bg-ukgold h-full transition-all duration-500 rounded-full';
            } else {
                bar.className = 'bg-uknavy h-full transition-all duration-500 rounded-full';
            }
            document.getElementById('mainDonutPercent').textContent = `${remPercent}%`;

            // Trip Overall Cumulative Spent
            let tripTotalSpent = 0;
            Object.values(appState.expenses).forEach(list => {
                list.forEach(item => { tripTotalSpent += Number(item.amount || 0); });
            });
            document.getElementById('tripTotalSpentGbp').textContent = formatGbp(tripTotalSpent);
            document.getElementById('tripTotalSpentJpy').textContent = formatJpy(tripTotalSpent);

            // Sub Category Cards Grid
            const catConfigs = [
                { key: '食事', icon: '☕️', label: '食事' },
                { key: 'ショッピング', icon: '🛍', label: '買い物' },
                { key: '交通費', icon: '🚌', label: '交通費' },
                { key: 'その他', icon: '💡', label: 'その他' }
            ];

            const catGrid = document.getElementById('categoryCardsGrid');
            catGrid.innerHTML = catConfigs.map(cfg => {
                const catSum = periodExpenses
                    .filter(e => e.category === cfg.key)
                    .reduce((s, e) => s + Number(e.amount || 0), 0);
                const share = spentPeriod > 0 ? Math.round((catSum / spentPeriod) * 100) : 0;

                return `
                    <div class="bg-white rounded-xl p-3 border border-uksidewalk shadow-sm flex flex-col justify-between">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[11px] font-bold text-slate-700 flex items-center gap-1">
                                <span>${cfg.icon}</span> ${cfg.label}
                            </span>
                            <span class="text-[10px] font-semibold text-slate-400">${share}%</span>
                        </div>
                        <div>
                            <div class="text-base font-black text-ukcinder leading-tight">${formatGbp(catSum)}</div>
                            <div class="text-[10px] text-slate-400 font-medium">${formatJpy(catSum)}</div>
                        </div>
                        <div class="w-full bg-slate-100 h-1 rounded-full overflow-hidden mt-2">
                            <div class="bg-uknavy h-full rounded-full transition-all duration-500" style="width: ${share}%"></div>
                        </div>
                    </div>
                `;
            }).join('');

            // Expense Table
            document.getElementById('expenseTableHeading').textContent = isAll ? '全日程の支出明細' : '本日の支出明細';
            document.getElementById('expenseItemCount').textContent = `${periodExpenses.length} 件`;

            const dateColHeader = document.getElementById('expenseDateColHeader');
            if (isAll) {
                dateColHeader.classList.remove('hidden');
            } else {
                dateColHeader.classList.add('hidden');
            }

            const tbody = document.getElementById('expenseTableBody');
            const colSpanCount = isAll ? 5 : 4;

            if (periodExpenses.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="${colSpanCount}" class="py-6 text-center text-xs text-slate-400">
                            記録がありません
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = periodExpenses.map(exp => {
                return `
                    <tr class="hover:bg-slate-50/80 transition">
                        ${isAll ? `<td class="py-2.5 text-[11px] font-bold text-slate-500 whitespace-nowrap">${escapeHtml(exp._dayShort)}</td>` : ''}
                        <td class="py-2.5 font-medium text-ukcinder text-xs">${escapeHtml(exp.title)}</td>
                        <td class="py-2.5 text-right font-bold text-ukcinder text-xs">${formatGbp(exp.amount)}</td>
                        <td class="py-2.5 text-right text-[11px] text-slate-400">${formatJpy(exp.amount)}</td>
                        <td class="py-2.5 text-center">
                            <button onclick="deleteExpenseItem('${exp.id}', '${exp._dateId}')" title="削除" class="text-slate-300 hover:text-uknavy p-1 transition">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ==========================================
        // SECTION 3: CHECKLIST
        // ==========================================
        function handleAddChecklistItem(e) {
            e.preventDefault();
            const category = document.getElementById('checkCategory').value;
            const text = document.getElementById('checkItemName').value.trim();
            if (!text) return;

            appState.checklist.push({
                id: 'chk_' + Date.now(),
                category,
                text,
                checked: false
            });
            saveState();

            document.getElementById('checkItemName').value = '';
            renderChecklist();
            showToast('持ち物リストにアイテムを追加しました');
        }

        function toggleChecklistItem(id) {
            const item = appState.checklist.find(c => c.id === id);
            if (item) {
                item.checked = !item.checked;
                saveState();
                renderChecklist();
            }
        }

        function deleteChecklistItem(id) {
            appState.checklist = appState.checklist.filter(c => c.id !== id);
            saveState();
            renderChecklist();
            showToast('アイテムを削除しました');
        }

        function renderChecklist() {
            const total = appState.checklist.length;
            const checkedCount = appState.checklist.filter(c => c.checked).length;
            const percent = total > 0 ? Math.round((checkedCount / total) * 100) : 0;

            document.getElementById('checklistCountText').textContent = `${checkedCount}/${total}`;
            document.getElementById('checklistPercentText').textContent = `${percent}%`;
            document.getElementById('checklistProgressBar').style.width = `${percent}%`;

            const categories = [
                { name: '貴重品・書類', icon: '🛂' },
                { name: '電子機器・通信', icon: '🔌' },
                { name: '衣類・防寒具', icon: '🧥' },
                { name: '日用品・常備薬', icon: '💊' }
            ];

            const grid = document.getElementById('checklistGrid');
            grid.innerHTML = categories.map(cat => {
                const items = appState.checklist.filter(c => c.category === cat.name);
                const catDone = items.filter(c => c.checked).length;

                return `
                    <div class="bg-white rounded-2xl p-5 border border-uksidewalk shadow-sm flex flex-col">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-3 mb-3">
                            <h3 class="font-bold text-ukcinder text-sm flex items-center gap-2">
                                <span class="text-base">${cat.icon}</span> ${escapeHtml(cat.name)}
                            </h3>
                            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full ${catDone === items.length && items.length > 0 ? 'bg-amber-100 text-amber-900 border border-ukgold/40' : 'bg-slate-100 text-slate-600'}">
                                ${catDone} / ${items.length}
                            </span>
                        </div>
                        <div class="space-y-2 flex-1">
                            ${items.length === 0 ? `<p class="text-xs text-slate-400 py-4 text-center">項目がありません</p>` : items.map(item => `
                                <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl border transition ${item.checked ? 'bg-amber-50/30 border-slate-100' : 'bg-white border-slate-200 hover:border-ukgold/60'}">
                                    <label class="flex items-center gap-3 cursor-pointer flex-1 select-none">
                                        <input type="checkbox" ${item.checked ? 'checked' : ''} onchange="toggleChecklistItem('${item.id}')" 
                                               class="w-4 h-4 rounded text-uknavy focus:ring-ukgold border-slate-300 cursor-pointer">
                                        <span class="text-sm transition ${item.checked ? 'line-through text-slate-400' : 'text-ukcinder font-medium'}">
                                            ${escapeHtml(item.text)}
                                        </span>
                                    </label>
                                    <button onclick="deleteChecklistItem('${item.id}')" title="削除" class="text-slate-300 hover:text-uknavy p-1 transition">
                                        <i class="fa-solid fa-xmark text-xs"></i>
                                    </button>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ==========================================
        // INITIALIZATION
        // ==========================================
        function renderAll() {
            document.getElementById('exchangeRateInput').value = appState.exchangeRate;
            renderDateButtons();
            renderItinerary();
            renderBudget();
            renderChecklist();
        }

        window.addEventListener('DOMContentLoaded', () => {
            setFormCategory(appState.formCategory || 'sightseeing');
            switchMainTab(appState.activeTab || 'itinerary');

            // Offline status detection listener
            function updateOnlineStatus() {
                const badge = document.getElementById('offlineBadge');
                if (!navigator.onLine) {
                    badge.classList.remove('hidden');
                    showToast('現在オフラインモードで動作中です (データは端末に保存されます)', 'warning');
                } else {
                    badge.classList.add('hidden');
                }
            }
            window.addEventListener('online', updateOnlineStatus);
            window.addEventListener('offline', updateOnlineStatus);
            updateOnlineStatus();

            // Register PWA Service Worker for Offline Capability
            if ('serviceWorker' in navigator) {
                const swCode = `
                    const CACHE_NAME = 'uk-trip-v1';
                    self.addEventListener('install', (e) => {
                        e.waitUntil(
                            caches.open(CACHE_NAME).then((cache) => {
                                return cache.addAll([
                                    './',
                                    'https://cdn.tailwindcss.com',
                                    'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css',
                                    'https://fonts.googleapis.com/css2?family=Anton&family=Cinzel:wght@600;700&family=Inter:wght@300;400;500;600;700;900&display=swap'
                                ]).catch(() => {});
                            })
                        );
                        self.skipWaiting();
                    });
                    self.addEventListener('fetch', (e) => {
                        e.respondWith(
                            caches.match(e.request).then((res) => {
                                return res || fetch(e.request).catch(() => caches.match('./'));
                            })
                        );
                    });
                `;
                const blob = new Blob([swCode], { type: 'application/javascript' });
                const swUrl = URL.createObjectURL(blob);
                navigator.serviceWorker.register(swUrl).catch(() => {});
            }
        });
    </script>
</body>
