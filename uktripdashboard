            } else {
                dotColor = 'bg-uksidewalk';
                badgeHtml = `<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 text-ukcinder border border-slate-200">💡 その他</span>`;
                titleHtml = `<h4 class="font-bold text-ukcinder text-xs sm:text-sm">${escapeHtml(item.title)}</h4>`;
