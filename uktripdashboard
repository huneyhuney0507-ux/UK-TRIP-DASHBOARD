<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UK Travel Companion | 🇬🇧 イギリス旅行ガイド & 収支・旅程管理</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Cinzel:wght@600;700&family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        uknavy: '#154673', // Header color (#154673)
                        ukred: '#882426',  // Burgundy
                        ukblue: '#154673',
                        ukgold: '#c2352f', // Golden Afternoon
                        uksidewalk: '#CDBEA7', // Sidewalk
                        ukcinder: '#323030', // Cinder
                        ukcream: '#F4F0E8', // Soft background matching sidewalk
                        cardbg: '#FFFFFF'
                    },
                    fontFamily: {
                        cinzel: ['Inter', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                        anton: ['Anton', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #F4F0E8;
            font-family: 'Inter', sans-serif;
            color: #323030;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #CDBEA7;
        }
        ::-webkit-scrollbar-thumb {
            background: #154673;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0E3050;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
        /* Mobile horizontal scroll container styling */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="text-ukcinder antialiased min-h-screen flex flex-col pb-24 max-w-md mx-auto sm:max-w-6xl shadow-2xl bg-[#F4F0E8]">

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="fixed top-16 right-4 z-50 flex flex-col gap-2 pointer-events-none max-w-[90vw]"></div>

    <!-- Custom Modal for Editing Daily Budget -->
    <div id="budgetModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-uksidewalk animate-fade-in">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-ukcinder text-base flex items-center gap-2">
                    <i class="fa-solid fa-coins text-ukgold"></i> 1日の目標予算を設定
                </h3>
                <button onclick="closeBudgetModal()" class="text-slate-400 hover:text-ukcinder p-2 rounded-full">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <p class="text-xs text-slate-500 mb-4" id="budgetModalDateLabel">12月1日 (火) の予算上限 (£ GBP)</p>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">予算額 (£ GBP)</label>
                    <input type="number" id="modalBudgetInput" step="1" min="0" class="w-full bg-slate-50 border border-slate-300 rounded-2xl px-4 py-3 text-xl font-bold text-ukcinder focus:outline-none focus:border-uknavy">
                    <p class="text-xs text-slate-400 mt-1 text-right" id="modalBudgetJpyPreview">≈ ¥21,082 JPY</p>
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="button" onclick="closeBudgetModal()" class="flex-1 py-3 rounded-xl border border-slate-200 text-slate-600 text-sm font-semibold hover:bg-slate-50 transition">
                        キャンセル
                    </button>
                    <button type="button" onclick="saveDailyTotalBudget()" class="flex-1 py-3 rounded-xl bg-uknavy text-white text-sm font-semibold hover:bg-ukcinder transition shadow">
                        保存する
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Schedule Detail Modal (Pop-up on item tap) -->
    <div id="scheduleDetailModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4" onclick="closeScheduleDetailModalOnBackdrop(event)">
        <div class="bg-[#ebc156] rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-ukcinder/20 animate-fade-in space-y-4" onclick="event.stopPropagation()">
            <!-- Top Header -->
            <div class="flex justify-between items-start gap-2 border-b border-ukcinder/15 pb-3">
                <div class="space-y-4">
                    <div id="modalDetailBadgeContainer" class="flex items-center gap-1.5 flex-wrap">
                        <!-- Dynamic Category / Date badges -->
                    </div>
                    <h3 id="modalDetailTitle" class="font-bold text-ukcinder text-lg leading-tight">--</h3>
                </div>
                <button onclick="closeScheduleDetailModal()" class="text-ukcinder/70 hover:text-ukcinder p-1.5 rounded-full bg-white/50 hover:bg-white/80 transition shrink-0">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Content Details -->
            <div class="space-y-3 text-xs text-ukcinder" id="modalDetailBody">
                <!-- Injected via JavaScript -->
            </div>

            <!-- Action Buttons at bottom -->
            <div class="pt-2 flex gap-2" id="modalDetailFooterActions">
                <!-- Action buttons injected via JavaScript -->
            </div>
        </div>
    </div>

    <!-- Header Banner (Optimized for iPhone notch/safe-area) -->
    <header class="bg-[#154673] text-white shadow-md sticky top-0 z-40 pt-safe">
        <div class="max-w-6xl mx-auto px-4 py-3.5 sm:py-5">
            <div class="flex items-center justify-between gap-2">
                <div class="text-left">
                    <div class="flex items-center gap-2">
                        <h1 class="font-anton text-lg sm:text-2xl tracking-wider text-amber-100 leading-tight">UK TRIP DASHBOARD</h1>
                        <!-- Offline Status Badge -->
                        <span id="offlineBadge" class="hidden text-[9px] bg-amber-500/80 text-white font-bold px-1.5 py-0.5 rounded flex items-center gap-1">
                            <i class="fa-solid fa-wifi-slash"></i> オフライン
                        </span>
                    </div>
                    <p class="text-[11px] sm:text-xs text-amber-100/80">2026.12.01 - 12.08 (8 Days in UK)</p>
                </div>

                <!-- Currency Rate Bar (Compact Mobile Style) -->
                <div class="bg-[#c2352f] border border-white/25 rounded-2xl p-1.5 px-3 flex items-center gap-2 shadow-inner text-xs">
                    <div class="flex items-center gap-1 text-white font-medium text-[11px]">
                        <span>1£=</span>
                        <input type="number" id="exchangeRateInput" step="0.01" value="210.82" 
                               class="w-16 bg-black/25 border border-white/30 rounded-lg px-1.5 py-0.5 text-right text-white font-bold focus:outline-none focus:border-white text-xs">
                        <span class="text-white/90 text-[10px]">円</span>
                    </div>
                    <button id="updateRateBtn" onclick="updateExchangeRate()" title="レート更新" class="text-[10px] bg-black/20 hover:bg-black/35 text-white p-1.5 rounded-lg border border-white/30 transition font-medium flex items-center">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Bottom Navigation Bar for Mobile (iPhone Thumb-friendly) -->
    <nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto sm:max-w-6xl bg-[#c2352f]/95 backdrop-blur-md border-t border-red-800 z-40 pb-safe">
        <div class="grid grid-cols-3 h-16">
            <button id="tabItineraryBtn" onclick="switchMainTab('itinerary')" class="flex flex-col items-center justify-center gap-1 text-white font-bold">
                <i class="fa-regular fa-calendar-days text-lg"></i>
                <span class="text-[10px]">SCHEDULE</span>
            </button>
            <button id="tabBudgetBtn" onclick="switchMainTab('budget')" class="flex flex-col items-center justify-center gap-1 text-white/70 font-medium">
                <i class="fa-solid fa-wallet text-lg"></i>
                <span class="text-[10px]">BUDGET</span>
            </button>
            <button id="tabChecklistBtn" onclick="switchMainTab('checklist')" class="flex flex-col items-center justify-center gap-1 text-white/70 font-medium">
                <i class="fa-solid fa-list-check text-lg"></i>
                <span class="text-[10px]">PACK LIST</span>
            </button>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto px-3.5 sm:px-4 mt-3 flex-1 w-full">

        <!-- Date Selector Navigation Bar (Horizontal Scroll for iPhone Aspect Ratio) -->
        <div id="dateSelectorBar" class="mb-4 bg-white p-2.5 rounded-2xl shadow-sm border border-uksidewalk">
            <div class="text-[11px] font-semibold text-slate-500 px-1 mb-2 flex justify-between items-center">
                <span><i class="fa-solid fa-plane-departure mr-1 text-uknavy"></i> 日程を選択</span>
                <span id="currentSelectedDateLabel" class="text-uknavy font-bold text-xs">12/01 (Tue)</span>
            </div>
            <!-- Horizontal Carousel for smooth swipe on mobile -->
            <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1 snap-x" id="dateButtonsContainer">
                <!-- Date buttons injected dynamically -->
            </div>
        </div>

        <!-- ================= SECTION 1: ITINERARY & SCHEDULE ================= -->
        <section id="sectionItinerary" class="space-y-4 animate-fade-in">
            <!-- Timeline on Top -->
            <div class="bg-white rounded-2xl p-4 sm:p-6 border border-uksidewalk shadow-sm min-h-[300px] flex flex-col">
                <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-2.5">
                    <h3 class="font-bold text-ukcinder text-sm sm:text-base flex items-center gap-1.5">
                        <i class="fa-solid fa-clock text-uknavy"></i> タイムライン
                    </h3>
                    <div class="flex items-center gap-2">
                        <span id="dailyEstimatedSum" class="text-[11px] sm:text-xs font-bold text-uknavy bg-amber-50 border border-ukgold/40 px-2 py-0.5 rounded-lg">予定計: £0.00</span>
                    </div>
                </div>

                <div id="scheduleTimeline" class="space-y-3 relative before:absolute before:inset-0 before:left-3 before:w-0.5 before:bg-uksidewalk/50 flex-1">
                    <!-- Timeline Items injected dynamically -->
                </div>
            </div>

            <!-- Add Schedule Form Card -->
            <div class="bg-white rounded-2xl p-4 sm:p-5 border border-uksidewalk shadow-sm">
                <h3 class="font-bold text-ukcinder text-sm mb-3 flex items-center justify-between">
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-plus text-ukgold"></i> 新しいスケジュールを追加</span>
                    <span id="scheduleCountBadge" class="bg-ukgold/20 text-ukcinder font-bold text-xs px-2 py-0.5 rounded-full border border-ukgold/40">0 件</span>
                </h3>

                <form id="addScheduleForm" onsubmit="handleAddSchedule(event)" class="space-y-3">
                    <!-- Category Selector Tabs -->
                    <div>
                        <label class="block text-[11px] text-slate-500 mb-1 font-medium">カテゴリー</label>
                        <div class="grid grid-cols-4 gap-1 p-1 bg-slate-100 rounded-xl text-xs font-semibold">
                            <button type="button" onclick="setFormCategory('sightseeing')" id="catBtn_sightseeing" class="py-2 rounded-lg bg-white text-uknavy shadow transition text-center">🏛 観光</button>
                            <button type="button" onclick="setFormCategory('dining')" id="catBtn_dining" class="py-2 rounded-lg text-slate-600 hover:bg-white/50 transition text-center">☕️ 食事</button>
                            <button type="button" onclick="setFormCategory('transport')" id="catBtn_transport" class="py-2 rounded-lg text-slate-600 hover:bg-white/50 transition text-center">🚌 移動</button>
                            <button type="button" onclick="setFormCategory('other')" id="catBtn_other" class="py-2 rounded-lg text-slate-600 hover:bg-white/50 transition text-center">💡 その他</button>
                        </div>
                    </div>

                    <!-- Common: Time -->
                    <div class="w-full overflow-hidden">
                        <label class="block text-[11px] text-slate-500 mb-1 font-medium">時間</label>
                        <input type="time" id="schedTime" required value="12:00" class="w-full min-w-0 box-border appearance-none bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm text-center focus:outline-none focus:border-uknavy font-semibold">
                    </div>

                    <!-- Dynamic: Sightseeing Form -->
                    <div id="formFields_sightseeing" class="space-y-2.5">
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">スポット名 <span class="text-uknavy">*</span></label>
                            <input type="text" id="sightSpot" placeholder="例: 大英博物館" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">メモ</label>
                            <input type="text" id="sightAction" placeholder="例: 展示見学・事前予約あり" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                        <div class="hidden">
                            <input type="text" id="sightMemo">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">Google Map URL</label>
                            <input type="url" id="sightMapUrl" placeholder="https://maps.google.com/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                    </div>

                    <!-- Dynamic: Dining Form -->
                    <div id="formFields_dining" class="space-y-2.5 hidden">
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">種別</label>
                                <select id="dineType" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-2 py-2.5 text-sm focus:outline-none focus:border-uknavy font-semibold">
                                    <option value="朝食 🍳">朝食 🍳</option>
                                    <option value="ランチ 🥪">ランチ 🥪</option>
                                    <option value="ディナー 🍷">ディナー 🍷</option>
                                    <option value="カフェ/ティー ☕️">カフェ ☕️</option>
                                    <option value="パブ 🍺">パブ 🍺</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">店名 <span class="text-uknavy">*</span></label>
                                <input type="text" id="dineName" placeholder="例: The Ritz" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">メモ</label>
                            <input type="text" id="dineMemo" placeholder="例: アフタヌーンティー予約" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">予約・参考URL</label>
                            <input type="url" id="dineUrl" placeholder="https://..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                    </div>

                    <!-- Dynamic: Transport Form -->
                    <div id="formFields_transport" class="space-y-2.5 hidden">
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">交通手段</label>
                            <select id="transMode" onchange="toggleTransportLineOptions()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy font-semibold">
                                <option value="Underground">🚇 地下鉄 (Underground)</option>
                                <option value="Bus">🚌 路線バス (Bus)</option>
                                <option value="Train">🚆 鉄道 (Train)</option>
                                <option value="Walking">🚶 徒歩 (Walking)</option>
                                <option value="Taxi">🚖 タクシー / Uber</option>
                                <option value="Flight">✈️ 飛行機 (Flight)</option>
                            </select>
                        </div>

                        <!-- Underground Specific Line Select -->
                        <div id="undergroundLineContainer" class="space-y-1">
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">路線 (Line)</label>
                            <select id="transLine" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                                <option value="Piccadilly">Piccadilly Line</option>
                                <option value="Bakerloo">Bakerloo Line</option>
                                <option value="Central">Central Line</option>
                                <option value="District">District Line</option>
                                <option value="Jubilee">Jubilee Line</option>
                                <option value="Northern">Northern Line</option>
                                <option value="Victoria">Victoria Line</option>
                                <option value="Elizabeth">Elizabeth Line</option>
                                <option value="Circle">Circle Line</option>
                                <option value="Metropolitan">Metropolitan Line</option>
                            </select>
                        </div>

                        <!-- Bus Number / Detail Input -->
                        <div id="busDetailContainer" class="space-y-1 hidden">
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">系統番号</label>
                            <input type="text" id="transBusNo" placeholder="例: 24" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>

                        <!-- Departure & Destination -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">出発地 <span class="text-uknavy">*</span></label>
                                <input type="text" id="transFrom" placeholder="例: Paddington" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">目的地 <span class="text-uknavy">*</span></label>
                                <input type="text" id="transTo" placeholder="例: Westminster" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">所要時間</label>
                                <input type="text" id="transDuration" placeholder="例: 25分" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">運賃 (£ GBP)</label>
                                <input type="number" step="0.01" min="0" id="transFare" placeholder="0.00" value="0.00" oninput="updateTransportCostPreview()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm font-semibold focus:outline-none focus:border-uknavy">
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic: Other Form -->
                    <div id="formFields_other" class="space-y-2.5 hidden">
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">タイトル <span class="text-uknavy">*</span></label>
                            <input type="text" id="otherTitle" placeholder="例: ホテルチェックイン" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">メモ</label>
                            <input type="text" id="otherMemo" placeholder="例: 荷物を預ける" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-uknavy">
                        </div>
                    </div>

                    <!-- Estimated Cost Input (Shared for non-transport) -->
                    <div id="estimatedCostContainer">
                        <label class="block text-[11px] text-slate-500 mb-0.5 font-medium">予想予算 (£ GBP)</label>
                        <div class="flex items-center gap-2">
                            <input type="number" step="0.01" min="0" id="schedCost" placeholder="0.00" value="0.00" oninput="updateSchedCostPreview()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm font-semibold focus:outline-none focus:border-uknavy">
                            <span id="schedCostJpyPreview" class="text-xs text-slate-500 font-medium whitespace-nowrap bg-slate-100 px-3 py-2.5 rounded-xl">≈ ¥0</span>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-uknavy hover:bg-ukcinder text-white font-semibold py-3 rounded-xl text-sm transition shadow-md mt-2 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus"></i> 予定を追加
                    </button>
                </form>
            </div>
        </section>

        <!-- ================= SECTION 2: BUDGET & EXPENSE ================= -->
        <section id="sectionBudget" class="space-y-4 hidden animate-fade-in">
            
            <!-- Main Top Banner: Overall Daily Remaining Budget -->
            <div class="bg-white rounded-3xl p-5 sm:p-6 border border-uksidewalk shadow-sm relative overflow-hidden">
                <div class="flex flex-col items-center text-center gap-4">
                    
                    <div class="flex items-center gap-1.5 text-slate-500 font-bold text-sm">
                        <i class="fa-solid fa-wallet text-ukgold"></i>
                        <span id="budgetDateHeading">12/01 の残りの予算</span>
                    </div>
                    
                    <!-- Remaining Big Text & Slash Total Budget -->
                    <div class="space-y-1">
                        <div class="flex items-baseline justify-center gap-1.5">
                            <span class="text-4xl sm:text-5xl font-black text-ukcinder tracking-tight" id="mainRemGbp">£100.00</span>
                            <span class="text-slate-500 font-semibold text-sm" id="mainRemJpy">(=¥21,082)</span>
                        </div>
                        
                        <div class="flex items-center justify-center gap-1.5 text-slate-500 font-semibold text-sm pt-1">
                            <span>上限:</span>
                            <span id="mainTotalGbp" class="font-bold text-ukcinder">£100.00</span>
                            <span class="text-xs text-slate-400" id="mainTotalJpy">(=¥21,082)</span>
                            <button onclick="promptEditDailyTotalBudget()" class="ml-1 text-xs text-uknavy hover:bg-amber-50 px-2 py-1 rounded-lg border border-ukgold/40 transition font-semibold">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                        </div>
                    </div>

